# /etc/nginx/sites-available/tuttilabs.xyz
#
# Apex + www for the portfolio site. Static output only, no proxy, no upstream.
#
# TLS: certbot adds the 443 server and the http->https redirect to this file
# (see scripts/deploy.sh). Until the Cloudflare A records point here, there is
# no certificate for these names, so this block serves port 80 only.
#
# The cuantum.tuttilabs.xyz vhost (API proxy) and the winr vhost are separate
# files and are not touched by this one.

server {
    listen 80;
    listen [::]:80;
    server_name tuttilabs.xyz www.tuttilabs.xyz;

    root /var/www/tuttilabs;
    index index.html;

    access_log /var/log/nginx/tuttilabs.access.log;
    error_log  /var/log/nginx/tuttilabs.error.log;

    charset utf-8;

    # Vite emits content-hashed filenames under /assets -> safe to cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # HTML is rewritten on every deploy; never let a proxy or browser keep it.
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
